{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": true,
 "properties": {
  "bpr_holdout": {
   "type": "object"
  },
  "clustering": {
   "type": "object"
  },
  "ff_robustness": {
   "type": "object"
  },
  "schema_version": {
   "const": "v1"
  },
  "tags": {
   "additionalProperties": {
    "pattern": "^(OBSERVED|DERIVED|PREDICTED|SIMULATED)(/(OBSERVED|DERIVED|PREDICTED|SIMULATED))*$",
    "type": "string"
   },
   "minProperties": 1,
   "type": "object"
  }
 },
 "required": [
  "schema_version",
  "tags",
  "bpr_holdout",
  "ff_robustness",
  "clustering"
 ],
 "title": "validation",
 "type": "object"
}
