{
  "name": "atlas-human-mobility",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:gallery": "VITE_GALLERY=1 vite build --outDir dist-gallery",
    "preview": "vite preview --port 4301 --strictPort",
